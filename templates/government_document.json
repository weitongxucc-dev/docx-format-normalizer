{
  "industry_id": "government_document",
  "industry_name": "党政机关公文",
  "standard": "GB/T 9704-2012《党政机关公文格式》",
  "page_setup": {
    "paper_size": "A4",
    "paper_width_mm": 210,
    "paper_height_mm": 297,
    "orientation": "portrait",
    "margins": {
      "top_mm": 37,
      "bottom_mm": 35,
      "left_mm": 28,
      "right_mm": 26
    },
    "content_area_width_mm": 156,
    "content_area_height_mm": 225,
    "lines_per_page": 22,
    "chars_per_line": 28,
    "gutter_mm": 0,
    "gutter_position": "left"
  },
  "body_text": {
    "font_cn": "仿宋_GB2312",
    "font_en": "Times New Roman",
    "font_size_pt": 16,
    "font_size_name": "三号",
    "line_spacing_rule": "fixed",
    "line_spacing_exact_pt": 28.8,
    "first_line_indent_chars": 2,
    "alignment": "justify",
    "text_color": "000000"
  },
  "cover_page_rules": {
    "allowed_elements": ["title", "subtitle", "date", "organization"],
    "disallowed_elements": ["navigation_labels", "data_tables", "page_number", "text_boxes", "decorative_lines"],
    "layout": {
      "elements": [
        {"name": "title", "position": "top_third", "alignment": "center", "font": "小标宋体", "size_pt": 22},
        {"name": "organization", "position": "bottom_third", "alignment": "center"},
        {"name": "date", "position": "bottom", "alignment": "center"}
      ],
      "vertical_distribution": "balanced",
      "min_empty_lines_between_title_and_date": 6,
      "notes": "标题居页面上1/3，日期居页面下1/3，中间留白"
    },
    "notes": "公文首页仅保留标题、发文机关和日期，删除导航标签和参数表格。标题在上方1/3处，日期在下方，中间留白。"
  },
  "title_heading": {
    "font_cn": "小标宋体",
    "font_en": "Times New Roman",
    "font_size_pt": 22,
    "font_size_name": "二号",
    "bold": false,
    "alignment": "center"
  },
  "headings": [
    {
      "level": 0,
      "name": "公文标题",
      "font": "小标宋体",
      "font_size_pt": 22,
      "font_size_name": "二号",
      "bold": false,
      "alignment": "center",
      "space_before_lines": 2,
      "space_after_lines": 2
    },
    {
      "level": 1,
      "name": "一级标题",
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false,
      "alignment": "left",
      "space_before_lines": 0.5,
      "space_after_lines": 0.5
    },
    {
      "level": 2,
      "name": "二级标题",
      "font_cn": "楷体",
      "font_en": "Times New Roman",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false,
      "alignment": "left",
      "space_before_lines": 0.5,
      "space_after_lines": 0.5
    }
  ],
  "hierarchy_fonts": [
    {
      "level": 1,
      "prefix_pattern": "^[一二三四五六七八九十]+、",
      "prefix_patterns": ["^[一二三四五六七八九十]+、"],
      "font": "黑体",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false
    },
    {
      "level": 2,
      "prefix_pattern": "^（[一二三四五六七八九十]+）",
      "prefix_patterns": ["^（[一二三四五六七八九十]+）", "^\\([一二三四五六七八九十]+\\)"],
      "font": "楷体",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false
    },
    {
      "level": 3,
      "prefix_pattern": "^\\d+\\.\\s",
      "prefix_patterns": ["^\\d+\\.\\s", "^\\d+、"],
      "font": "仿宋_GB2312",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false
    },
    {
      "level": 4,
      "prefix_pattern": "^（\\d+）",
      "prefix_patterns": ["^（\\d+）", "^\\(\\d+\\)"],
      "font": "仿宋_GB2312",
      "font_size_pt": 16,
      "font_size_name": "三号",
      "bold": false
    }
  ],
  "header_footer": {
    "has_header": false,
    "has_footer": true,
    "footer_type": "page_number",
    "page_number_font": "宋体",
    "page_number_size_pt": 14,
    "page_number_size_name": "四号",
    "page_number_format": "half_width_arabic",
    "page_number_position": "bottom_center",
    "page_number_odd_align": "right",
    "page_number_even_align": "left",
    "has_dash_lines": true,
    "dash_line_distance_mm": 7
  },
  "tables": {
    "border_style": "single",
    "border_width_pt": 0.5,
    "table_alignment": "center",
    "header_row_bold": true,
    "cell_font_cn": "仿宋_GB2312",
    "cell_font_en": "Times New Roman",
    "cell_font_size_pt": 16
  },
  "images": {
    "caption_position": "below",
    "caption_alignment": "center",
    "caption_font": "仿宋_GB2312",
    "caption_font_size_pt": 14
  },
  "force_clear": [],
  "special_elements": {
    "issue_org_logo": {
      "font": "小标宋体",
      "color": "FF0000",
      "position": "center",
      "top_distance_mm": 35
    },
    "red_separator_line": {
      "color": "FF0000",
      "width": "full_content_area"
    },
    "seal": {
      "color": "FF0000"
    }
  },
  "printing": {
    "double_sided": true,
    "binding_side": "left"
  },
  "font_fallback": {
    "小标宋体": "STSong",
    "仿宋_GB2312": "STFangsong",
    "仿宋": "STFangsong",
    "黑体": "STHeiti",
    "楷体": "STKaiti",
    "楷体_GB2312": "STKaiti",
    "宋体": "STSong"
  }
}
