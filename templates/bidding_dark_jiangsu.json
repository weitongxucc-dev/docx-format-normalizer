{
  "industry_id": "bidding_dark_jiangsu",
  "industry_name": "招投标暗标（江苏省）",
  "standard": "江苏省公共资源交易网暗标编制规范",
  "page_setup": {
    "paper_size": "A4",
    "paper_width_mm": 210,
    "paper_height_mm": 297,
    "orientation": "portrait",
    "margins": {
      "top_mm": 25,
      "bottom_mm": 25,
      "left_mm": 25,
      "right_mm": 25
    },
    "gutter_mm": 0
  },
  "body_text": {
    "font_cn": "宋体",
    "font_en": "宋体",
    "font_size_pt": 12,
    "font_size_name": "小四号",
    "line_spacing_rule": "single",
    "first_line_indent_chars": 2,
    "alignment": "left",
    "text_color": "000000"
  },
  "headings": [
    {
      "level": 0,
      "name": "章标题",
      "font": "宋体",
      "font_size_pt": 12,
      "font_size_name": "小四号",
      "bold": false,
      "alignment": "center"
    },
    {
      "level": 1,
      "name": "节标题",
      "font": "宋体",
      "font_size_pt": 12,
      "font_size_name": "小四号",
      "bold": false,
      "alignment": "left"
    }
  ],
  "hierarchy_fonts": [
    {
      "level": 1,
      "prefix_pattern": "^第[一二三四五六七八九十]+章",
      "prefix_patterns": ["^第[一二三四五六七八九十]+章", "^[一二三四五六七八九十]+、"],
      "font": "宋体",
      "font_size_pt": 12,
      "bold": false
    },
    {
      "level": 2,
      "prefix_pattern": "^第[一二三四五六七八九十]+节",
      "prefix_patterns": ["^第[一二三四五六七八九十]+节", "^\\d+\\.\\d+", "^（[一二三四五六七八九十]+）"],
      "font": "宋体",
      "font_size_pt": 12,
      "bold": false
    },
    {
      "level": 3,
      "prefix_pattern": "^\\d+\\.\\d+",
      "prefix_patterns": ["^\\d+\\.\\d+\\.\\d+", "^\\d+\\.\\d+", "^\\d+\\.\\s"],
      "font": "宋体",
      "font_size_pt": 12,
      "bold": false
    }
  ],
  "header_footer": {
    "has_header": false,
    "has_footer": false,
    "has_page_number": false
  },
  "tables": {
    "border_style": "single",
    "border_width_pt": 0.5,
    "table_alignment": "center",
    "cell_font_cn": "宋体",
    "cell_font_en": "宋体",
    "cell_font_size_pt": 12
  },
  "images": {
    "caption_position": "below",
    "caption_alignment": "center",
    "caption_font": "宋体",
    "caption_font_size_pt": 12
  },
  "force_clear": [
    "bold",
    "italic",
    "underline",
    "strikethrough",
    "colored_text",
    "colored_background",
    "headers",
    "footers",
    "page_numbers",
    "table_of_contents",
    "hyperlink_coloring"
  ],
  "printing": {
    "double_sided": false,
    "binding_side": "left"
  }
}
