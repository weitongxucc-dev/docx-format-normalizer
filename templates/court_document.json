{
  "industry_id": "court_document",
  "industry_name": "法院诉讼文书",
  "standard": "《人民法院民事裁判文书制作规范》《民事诉讼文书样式》（法〔2016〕221号）",
  "page_setup": {
    "paper_size": "A4",
    "paper_width_mm": 210,
    "paper_height_mm": 297,
    "orientation": "portrait",
    "margins": {
      "top_mm": 30,
      "bottom_mm": 27,
      "left_mm": 28,
      "right_mm": 25
    },
    "lines_per_page": 22,
    "chars_per_line": 28,
    "left_greater_than_right": true,
    "top_greater_than_bottom": true
  },
  "cover_page_rules": {
    "allowed_elements": [
      "court_name",
      "document_title",
      "case_number",
      "parties",
      "date"
    ],
    "disallowed_elements": [
      "navigation_labels",
      "data_tables",
      "text_boxes",
      "decorative_lines",
      "logos",
      "page_number"
    ],
    "layout": {
      "elements": [
        {
          "name": "court_name",
          "position": "line_2",
          "alignment": "center",
          "font": "宋体",
          "size_pt": 22
        },
        {
          "name": "document_title",
          "position": "line_4",
          "alignment": "center"
        },
        {
          "name": "case_number",
          "position": "line_6",
          "alignment": "right"
        },
        {
          "name": "parties",
          "position": "body_start",
          "alignment": "left"
        },
        {
          "name": "date",
          "position": "bottom",
          "alignment": "right"
        }
      ],
      "vertical_distribution": "compact",
      "date_format": "chinese_uppercase",
      "notes": "法院名称居中第2行，文书名称居中，案号右对齐，日期用中文大写在结尾处"
    },
    "notes": "法院文书首页仅保留法院名称、文书名称、案号和当事人信息，日期用中文大写"
  },
  "body_text": {
    "font_cn": "仿宋_GB2312",
    "font_en": "Times New Roman",
    "font_size_pt": 16,
    "font_size_name": "三号",
    "line_spacing_rule": "fixed",
    "line_spacing_exact_pt": 28.8,
    "first_line_indent_chars": 2,
    "alignment": "justify",
    "text_color": "000000"
  },
  "headings": [
    {
      "level": 0,
      "name": "法院名称",
      "font": "宋体",
      "font_size_pt": 22,
      "font_size_name": "二号",
      "bold": true,
      "char_spacing_pt": 2,
      "alignment": "center",
      "position": "line_2"
    },
    {
      "level": 1,
      "name": "文书名称",
      "font": "大标宋体",
      "font_size_pt": 26,
      "font_size_name": "一号",
      "bold": true,
      "char_spacing_pt": 2,
      "alignment": "center",
      "position": "below_court_name"
    }
  ],
  "case_number": {
    "font": "仿宋_GB2312",
    "font_size_pt": 16,
    "font_size_name": "三号",
    "alignment": "right",
    "position": "below_court_name_one_line",
    "space_to_line_end": "2_chars"
  },
  "signature_block": {
    "font": "仿宋_GB2312",
    "font_size_pt": 16,
    "font_size_name": "三号",
    "alignment": "right",
    "right_indent_chars": 4,
    "elements": [
      "审判长",
      "审判员",
      "成文时间",
      "书记员"
    ],
    "time_format": "chinese_full",
    "time_zero_char": "○",
    "seal_method": "bottom_overlap_on_time"
  },
  "header_footer": {
    "has_header": false,
    "has_footer": true,
    "footer_type": "page_number",
    "page_number_font": "宋体",
    "page_number_size_pt": 14,
    "page_number_size_name": "四号",
    "page_number_format": "half_width_arabic",
    "page_number_odd_align": "right",
    "page_number_even_align": "left",
    "page_number_indent_chars": 1,
    "has_dash_lines": true,
    "dash_line_distance_mm": 7
  },
  "tables": {
    "border_style": "single",
    "border_width_pt": 0.5,
    "table_alignment": "center"
  },
  "force_clear": [],
  "printing": {
    "double_sided": true,
    "multi_page_binding": "paste",
    "no_staples": true,
    "no_cross_seal": true
  },
  "special_rules": {
    "foreign_court_prefix": "中华人民共和国",
    "foreign_court_font": "小标宋体",
    "foreign_court_size": "二号",
    "empty_pages_no_page_number": true,
    "avoid_this_page_no_text": true
  },
  "font_fallback": {
    "小标宋体": "STSong",
    "仿宋_GB2312": "STFangsong",
    "仿宋": "STFangsong",
    "黑体": "STHeiti",
    "楷体": "STKaiti",
    "楷体_GB2312": "STKaiti",
    "宋体": "STSong",
    "方正小标宋简体": "STSong",
    "方正仿宋_GBK": "STFangsong"
  }
}