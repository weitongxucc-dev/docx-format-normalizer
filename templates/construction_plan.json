{
  "industry_id": "construction_plan",
  "industry_name": "工程施工方案",
  "standard": "行业通行规范",
  "page_setup": {
    "paper_size": "A4",
    "paper_width_mm": 210,
    "paper_height_mm": 297,
    "orientation": "portrait",
    "margins": {
      "top_mm": 25,
      "bottom_mm": 25,
      "left_mm": 31.7,
      "right_mm": 25
    }
  },
  "cover_page_rules": {
    "allowed_elements": ["project_name", "plan_name", "organization", "date", "version", "signature_block"],
    "disallowed_elements": ["navigation_labels", "data_tables", "text_boxes", "decorative_lines", "logos", "page_number"],
    "layout": {
      "elements": [
        {"name": "plan_name", "position": "top_third", "alignment": "center", "font": "宋体", "size_pt": 22},
        {"name": "project_name", "position": "below_plan_name", "alignment": "center"},
        {"name": "organization", "position": "middle", "alignment": "center"},
        {"name": "version", "position": "below_organization", "alignment": "center"},
        {"name": "signature_block", "position": "bottom", "alignment": "left"},
        {"name": "date", "position": "bottom", "alignment": "center"}
      ],
      "vertical_distribution": "balanced",
      "min_empty_lines_between_title_and_signature": 8,
      "notes": "方案名称居页面上1/3，编制单位和日期在页面下1/3，签字栏在底部"
    },
    "notes": "施工方案封面仅保留工程名称、方案名称、编制单位、日期和版本号，底部签字栏除外"
  },
  "body_text": {
    "font_cn": "宋体",
    "font_en": "Times New Roman",
    "font_size_pt": 14,
    "font_size_name": "四号",
    "line_spacing_rule": "1.5x",
    "first_line_indent_chars": 2,
    "alignment": "justify",
    "text_color": "000000",
    "space_before_lines": 0,
    "space_after_lines": 0
  },
  "headings": [
    {
      "level": 1,
      "name": "一级标题",
      "prefix_pattern": "^第[一二三四五六七八九十]+章",
      "prefix_patterns": ["^第[一二三四五六七八九十]+章", "^[一二三四五六七八九十]+、"],
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "font_size_pt": 14,
      "font_size_name": "四号",
      "bold": true,
      "alignment": "center",
      "space_before_lines": 1,
      "space_after_lines": 1,
      "line_spacing": "1.5x",
      "outline_level": 1
    },
    {
      "level": 2,
      "name": "二级标题",
      "prefix_pattern": "^\\d+\\.\\d+",
      "prefix_patterns": ["^\\d+\\.\\d+", "^第[一二三四五六七八九十]+节"],
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "font_size_pt": 14,
      "font_size_name": "四号",
      "bold": true,
      "alignment": "left",
      "space_before_lines": 1,
      "space_after_lines": 1,
      "line_spacing": "1.5x",
      "outline_level": 2
    },
    {
      "level": 3,
      "name": "三级标题",
      "prefix_pattern": "^\\d+\\.\\d+\\.\\d+",
      "prefix_patterns": ["^\\d+\\.\\d+\\.\\d+", "^\\d+\\.\\d+"],
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "font_size_pt": 14,
      "font_size_name": "四号",
      "bold": true,
      "alignment": "left",
      "outline_level": 3
    }
  ],
  "hierarchy_fonts": [
    {
      "level": 1,
      "prefix_pattern": "^第[一二三四五六七八九十]+章",
      "prefix_patterns": ["^第[一二三四五六七八九十]+章", "^[一二三四五六七八九十]+、"],
      "font": "宋体",
      "font_size_pt": 14,
      "bold": true
    },
    {
      "level": 2,
      "prefix_pattern": "^\\d+\\.\\d+",
      "prefix_patterns": ["^\\d+\\.\\d+", "^第[一二三四五六七八九十]+节"],
      "font": "宋体",
      "font_size_pt": 14,
      "bold": true
    }
  ],
  "title_heading": {
    "name": "文档标题",
    "font_cn": "黑体",
    "font_en": "Times New Roman",
    "font_size_pt": 16,
    "font_size_name": "三号",
    "bold": false,
    "alignment": "center"
  },
  "tables": {
    "border_style": "single",
    "border_width_pt": 0.5,
    "table_alignment": "center",
    "cell_font_size_pt": 12,
    "cell_font_size_name": "小四号",
    "cell_font_cn": "宋体",
    "cell_font_en": "Times New Roman",
    "no_punctuation_in_cells": true
  },
  "figures": {
    "caption_position": "below",
    "caption_alignment": "center",
    "caption_font_cn": "宋体",
    "caption_font_en": "Times New Roman",
    "caption_font_size_pt": 12
  },
  "header_footer": {
    "has_header": true,
    "has_footer": true,
    "has_page_number": true
  },
  "foreign_symbols": {
    "scalars_variables": "italic",
    "functions_units_codes": "upright",
    "consistency_required": true
  },
  "force_clear": [],
  "printing": {
    "double_sided": false,
    "binding_side": "left"
  }
}
